#!/usr/bin/env bash
# Author: TJ Sharley <tsharley@gmail.com>, copyright 2024
script_version=2.0
debug_mode=false
###############################################################################%

usage(){
	cat <<-'EOF'
	Usage: mkexe "NAME"
	Creates executable ~/.local/bin/"NAME" (in $PATH) and opens it in $EDITOR.
	EOF
}

parse_flags() {
	while [[ ${1:0:1} == - ]]; do
		case "$1" in
			-h)	usage; exit 0;;
			-v) echo "Version $script_version"; exit 0;;
			-d) debug_mode=true;;
			-b) template_type="script_bash";;
			-p) template_type="script_python";;
			-*) echo "Invalid flag/option: $1"; exit 1;;
		esac
		shift
	done
}

main(){
	template_type="script_bash"    # default
	if [[ ${1:0:1} == - ]]; then
		parse_flags "$@"
	fi

	template="${TSM_TEMPLATE_DIR}/script/$template_type"
	output_file="$HOME/.local/bin/$1"
	
	if [[ -e "$output_file" ]]; then
		echo "Error: File already exists.  Opening..."
		sleep 1
	else
		cp "$template" "$output_file"
		chmod +x "$output_file"
		sleep .5
	fi
	"$EDITOR" "$output_file"
}

if [[ "$#" ==  0 ]]; then
	usage; exit
fi 


main "$@"
